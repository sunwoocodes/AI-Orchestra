# ============================================================
# AI 오케스트레이터 Git Ignore 설정
# ============================================================

# ── 환경 변수 및 시크릿 ──────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── 가상환경 ────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── 파이썬 바이트코드 & 캐시 ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 파이프라인 결과물 및 로그 ────────────────────────────────
results/
*.log
logs/

# ── 브라우저 프로필 & 세션 데이터 (프로젝트 내 임시 생성 시) ──
browser_profiles/
user_data/
.playwright/

# ── IDE & OS 설정 파일 ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
