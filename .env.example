# AI 오케스트레이터 환경 변수 설정
# 이 파일을 .env 로 복사하고 값을 채우세요.
# .env 파일은 절대 Git에 올리지 마세요.
#
# 사용법:
#   cp .env.example .env
#   nano .env  (값 입력 후 저장)

# Notion 연동 (선택)
# Notion 내부 통합 토큰: https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=

# 보고서를 저장할 Notion 데이터베이스 ID
# 데이터베이스 URL의 마지막 32자리 문자열
NOTION_DATABASE_ID=

# Discord 연동 (선택)
# Discord 채널 웹훅 URL
# 서버 설정 → 연동 → 웹훅 → 새 웹훅에서 생성
DISCORD_WEBHOOK_URL=
